---
export interface DayStats {
    day: number;
    from: string;
    to: string;
    paddleLengthKm: number;
    portageLengthKm: number;
    portageCount: number;
}

interface Props {
    days: DayStats[];
}

const { days } = Astro.props;
---

<div class="max-w-4xl mx-auto px-4 md:px-8 mb-12">
    <div class="space-y-4">
        {
            days.map((day) => (
                <div class="p-6 bg-zinc-50 rounded-xl border border-zinc-100">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-4">
                        <h3 class="text-lg font-bold text-zinc-900">
                            Day {day.day}
                        </h3>
                        <p class="text-sm text-zinc-500">
                            {day.from} → {day.to}
                        </p>
                    </div>
                    <div class="grid grid-cols-3 gap-4">
                        <div class="flex flex-col items-center text-center">
                            <span class="text-zinc-500 text-xs font-semibold uppercase tracking-wider mb-1">
                                Paddle Distance
                            </span>
                            <span class="text-xl font-bold text-river-700">
                                {day.paddleLengthKm}{" "}
                                <small class="text-sm font-normal text-zinc-400">
                                    km
                                </small>
                            </span>
                        </div>
                        <div class="flex flex-col items-center text-center">
                            <span class="text-zinc-500 text-xs font-semibold uppercase tracking-wider mb-1">
                                Portages
                            </span>
                            <span class="text-xl font-bold text-bark-700">
                                {day.portageCount}
                            </span>
                        </div>
                        <div class="flex flex-col items-center text-center">
                            <span class="text-zinc-500 text-xs font-semibold uppercase tracking-wider mb-1">
                                Portage Distance
                            </span>
                            <span class="text-xl font-bold text-bark-700">
                                {day.portageLengthKm}{" "}
                                <small class="text-sm font-normal text-zinc-400">
                                    km
                                </small>
                            </span>
                        </div>
                    </div>
                </div>
            ))
        }
    </div>
</div>
