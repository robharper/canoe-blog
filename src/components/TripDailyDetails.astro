---
export interface DayStats {
    day: number;
    from: string;
    to: string;
    paddleLengthKm: number;
    portageLengthKm: number;
    portageCount: number;
}

interface Props {
    days: DayStats[];
    /**
     * Optional day number to render just that single day instead of the
     * full trip breakdown. Useful for interleaving each day's stats with
     * that day's narrative content in the trip's markdown/MDX body.
     */
    day?: number;
    /**
     * Whether to show the heading row (day number and from/to locations)
     * above the stats grid. Defaults to true; set to false when the
     * surrounding content already provides that context (e.g. a markdown
     * heading immediately above the component).
     */
    showHeader?: boolean;
}

const { days, day, showHeader = true } = Astro.props;

const daysToRender =
    day === undefined ? days : days.filter((d) => d.day === day);

if (day !== undefined && daysToRender.length === 0) {
    console.warn(`[TripDailyDetails] No day ${day} found in the provided days.`);
}
---

<div class="space-y-4">
    {
        daysToRender.map((day) => (
            <div class="p-6 bg-zinc-50 rounded-xl border border-zinc-100">
                {showHeader && (
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 mb-4">
                        <h3 class="text-lg font-bold text-zinc-900 mt-0 mb-0">
                            Day {day.day}
                        </h3>
                        <p class="text-sm text-zinc-500">
                            {day.from} → {day.to}
                        </p>
                    </div>
                )}
                <div class="grid grid-cols-3 gap-4">
                    <div class="flex flex-col items-center text-center">
                        <span class="text-zinc-500 text-xs font-semibold uppercase tracking-wider mb-1">
                            Paddle Distance
                        </span>
                        <span class="text-xl font-bold text-river-700">
                            {day.paddleLengthKm}{" "}
                            <small class="text-sm font-normal text-zinc-400">
                                km
                            </small>
                        </span>
                    </div>
                    <div class="flex flex-col items-center text-center">
                        <span class="text-zinc-500 text-xs font-semibold uppercase tracking-wider mb-1">
                            Portages
                        </span>
                        <span class="text-xl font-bold text-bark-700">
                            {day.portageCount}
                        </span>
                    </div>
                    <div class="flex flex-col items-center text-center">
                        <span class="text-zinc-500 text-xs font-semibold uppercase tracking-wider mb-1">
                            Portage Distance
                        </span>
                        <span class="text-xl font-bold text-bark-700">
                            {day.portageLengthKm}{" "}
                            <small class="text-sm font-normal text-zinc-400">
                                km
                            </small>
                        </span>
                    </div>
                </div>
            </div>
        ))
    }
</div>

