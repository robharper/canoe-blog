---
import "maplibre-gl/dist/maplibre-gl.css";

interface Props {
    geojson: string;
    center?: [number, number];
    interactive?: string | null;
    showPortageTooltips?: boolean;
}

const { geojson, center, interactive = null, showPortageTooltips = false } = Astro.props;

const geojsonPath = geojson.startsWith("/") ? geojson.slice(1) : geojson;
const geojsonUrl = `${import.meta.env.BASE_URL}${geojsonPath}`;
const lakesUrl = `${import.meta.env.BASE_URL}geo/algonquin-lakes.geo.json`;
const interactiveHref = interactive
    ? `${import.meta.env.BASE_URL}trips/`
    : null;

// Server-side bounds calculation
let serverBounds = null;
try {
    const geojsonFiles = import.meta.glob('/public/geo/*.json', { eager: true }) as Record<string, any>;
    const normalizedPath = geojson.startsWith('/') ? geojson : `/${geojson}`;
    const key = `/public${normalizedPath}`;

    let data;
    if (geojsonFiles[key]) {
        data = geojsonFiles[key].default || geojsonFiles[key];
    } else {
        console.warn(`GeoJSON file not found for map: ${key}`);
    }

    if (data && data.features) {
        let minLng = Infinity,
            minLat = Infinity,
            maxLng = -Infinity,
            maxLat = -Infinity;
        let hasCoords = false;

        data.features.forEach((feature: any) => {
            if (feature.geometry.type === "LineString") {
                feature.geometry.coordinates.forEach(
                    (coord: [number, number]) => {
                        minLng = Math.min(minLng, coord[0]);
                        minLat = Math.min(minLat, coord[1]);
                        maxLng = Math.max(maxLng, coord[0]);
                        maxLat = Math.max(maxLat, coord[1]);
                        hasCoords = true;
                    },
                );
            } else if (feature.geometry.type === "Point") {
                const coord = feature.geometry.coordinates;
                minLng = Math.min(minLng, coord[0]);
                minLat = Math.min(minLat, coord[1]);
                maxLng = Math.max(maxLng, coord[0]);
                maxLat = Math.max(maxLat, coord[1]);
                hasCoords = true;
            }
        });

        if (hasCoords) {
            serverBounds = [
                [minLng, minLat],
                [maxLng, maxLat],
            ];
        }
    }
} catch (error) {
    console.error("Error calculating server-side bounds:", error);
}
---

<div class="relative group/map w-screen ml-[calc(50%-50vw)] md:ml-0 md:w-full">
    <div
        id="map"
        class="w-full aspect-[8/9] md:aspect-video rounded-none md:rounded-lg shadow-none md:shadow-md border-y md:border border-zinc-200"
        data-geojson={geojsonUrl}
        data-lakes={lakesUrl}
        data-center={JSON.stringify(center)}
        data-bounds={JSON.stringify(serverBounds)}
        data-interactive={interactive}
        data-interactive-href={interactiveHref}
        data-portage-tooltips={showPortageTooltips ? "true" : null}
    >
    </div>

    <button
        id="reset-map"
        class="absolute top-4 right-4 z-10 px-3 py-1.5 bg-white/90 backdrop-blur-sm border border-zinc-200 rounded-md shadow-sm text-xs font-medium text-zinc-700 hover:bg-white hover:text-river-600 transition-all opacity-0 group-hover/map:opacity-100 focus:opacity-100"
        aria-label="Reset map view"
    >
        Reset View
    </button>
</div>

<style>
    :global(.portage-tooltip .maplibregl-popup-content) {
        background: #b11d1b;
        color: white;
        font-family: 'Inter', system-ui, sans-serif;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 4px 8px;
        border-radius: 4px;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
        white-space: nowrap;
    }

    :global(.portage-tooltip .maplibregl-popup-tip) {
        border-top-color: #b11d1b;
    }
</style>

<script>
    import maplibregl from "maplibre-gl";
    import { navigate } from "astro:transitions/client";

    function adjustHexColor(hex: string, amount: number): string {
        const num = parseInt(hex.slice(1), 16);
        const r = (num >> 16) & 255;
        const g = (num >> 8) & 255;
        const b = num & 255;

        const adjust = (channel: number) => {
            if (amount > 0) {
                return Math.min(255, Math.round(channel + (255 - channel) * amount));
            }
            return Math.max(0, Math.round(channel * (1 + amount)));
        };

        const toHex = (channel: number) => channel.toString(16).padStart(2, "0");
        return `#${toHex(adjust(r))}${toHex(adjust(g))}${toHex(adjust(b))}`;
    }

    const COLORS = {
        portage: {
            base: "#b11d1b",
            dark: adjustHexColor("#b11d1b", -0.25),
            light: adjustHexColor("#b11d1b", 0.45),
        },
        water: {
            base: "#2584cb",
            dark: adjustHexColor("#2584cb", -0.25),
            light: adjustHexColor("#2584cb", 0.45),
        },
        campsite: {
            base: "#3ea34b",
            dark: adjustHexColor("#3ea34b", -0.25),
            light: adjustHexColor("#3ea34b", 0.45),
        },
    };

    const baseLineColor = [
        "match",
        ["get", "canoe"],
        "portage",
        COLORS.portage.base,
        COLORS.water.base,
    ] as maplibregl.ExpressionSpecification;

    const mapContainer = document.getElementById("map");
    const resetButton = document.getElementById("reset-map");
    const geojsonUrl = mapContainer?.dataset.geojson;
    const lakesUrl = mapContainer?.dataset.lakes;
    const centerData = mapContainer?.dataset.center;
    const boundsData = mapContainer?.dataset.bounds;
    const interactiveProp = mapContainer?.dataset.interactive;
    const interactiveHref = mapContainer?.dataset.interactiveHref;
    const portageTooltips = mapContainer?.dataset.portageTooltips === "true";

    const initialCenter = centerData ? JSON.parse(centerData) : [-77.77, 45.86];
    const serverBounds = boundsData ? JSON.parse(boundsData) : null;

    if (mapContainer && geojsonUrl) {
        const map = new maplibregl.Map({
            container: "map",
            style: "https://api.maptiler.com/maps/9ee3fbec-1620-437f-9b35-e74ba4568490/style.json?key=WJJ16dpcfvolmmWp8Tcv",
            center: initialCenter,
            zoom: 10,
            maxBounds: [
                [-79.6, 45.0],
                [-77.0, 46.5],
            ],
        });

        // Fit bounds immediately if available from server
        if (serverBounds) {
            map.fitBounds(serverBounds, {
                padding: 50,
                animate: false, // Don't animate on first load
            });
        }

        // Handle reset button click
        resetButton?.addEventListener("click", () => {
            if (serverBounds) {
                map.fitBounds(serverBounds, {
                    padding: 50,
                    animate: true,
                });
            } else {
                map.setCenter(initialCenter);
                map.setZoom(10);
            }
        });

        map.on("load", async () => {
            try {
                for (const layerId of ["Lake labels", "Lakeline labels"]) {
                    if (map.getLayer(layerId)) {
                        map.setLayoutProperty(layerId, "visibility", "none");
                    }
                }

                const lakesPromise = lakesUrl
                    ? fetch(lakesUrl).then((r) => r.json())
                    : Promise.resolve(null);
                const [data, lakesData] = await Promise.all([
                    fetch(geojsonUrl).then((r) => r.json()),
                    lakesPromise,
                ]);

                if (lakesData) {
                    map.addSource("lake-names", {
                        type: "geojson",
                        data: lakesData,
                    });

                    const lakeLabelLayout = {
                        "text-field": ["get", "name"],
                        "text-font": ["Roboto Italic", "Noto Sans Italic"],
                        "text-size": [
                            "interpolate",
                            ["linear"],
                            ["zoom"],
                            8,
                            10,
                            14,
                            13,
                        ],
                        "text-max-width": 6,
                        "text-padding": 2,
                        "text-letter-spacing": 0.05,
                        "symbol-sort-key": ["-", ["get", "area"]],
                        "text-allow-overlap": false,
                        "text-optional": true,
                    };
                    const lakeLabelPaint = {
                        "text-color": "#1e3a5f",
                        "text-halo-color": "rgba(255,255,255,0.85)",
                        "text-halo-width": 1.5,
                    };

                    // Large ≥2km² from z8; medium ≥0.3km² from z10; rest from z12
                    map.addLayer({
                        id: "lake-names-large",
                        type: "symbol",
                        source: "lake-names",
                        minzoom: 8,
                        filter: [">=", ["get", "area"], 2_000_000],
                        layout: lakeLabelLayout,
                        paint: lakeLabelPaint,
                    });
                    map.addLayer({
                        id: "lake-names-medium",
                        type: "symbol",
                        source: "lake-names",
                        minzoom: 10,
                        filter: [
                            "all",
                            [">=", ["get", "area"], 300_000],
                            ["<", ["get", "area"], 2_000_000],
                        ],
                        layout: lakeLabelLayout,
                        paint: lakeLabelPaint,
                    });
                    map.addLayer({
                        id: "lake-names-small",
                        type: "symbol",
                        source: "lake-names",
                        minzoom: 12,
                        filter: ["<", ["get", "area"], 300_000],
                        layout: lakeLabelLayout,
                        paint: lakeLabelPaint,
                    });
                }

                map.addSource("canoe-data", {
                    type: "geojson",
                    data: data,
                });

                map.addLayer({
                    id: "canoe",
                    type: "line",
                    source: "canoe-data",
                    layout: {
                        "line-cap": "round",
                        "line-join": "round",
                    },
                    paint: {
                        "line-width": [
                            "match",
                            ["get", "canoe"],
                            "portage",
                            3,
                            5,
                        ],
                        "line-color": baseLineColor,
                    },
                    filter: ["==", "$type", "LineString"],
                });

                map.addLayer({
                    id: "campsites",
                    type: "symbol",
                    source: "canoe-data",
                    layout: {
                        "icon-image": [
                            "match",
                            ["get", "tourism"],
                            "camp_site",
                            "campsite",
                            "circle",
                        ],
                        "icon-size": 1.5,
                        "text-field": [
                            "case",
                            ["==", ["get", "tourism"], "camp_site"],
                            ["to-string", ["get", "label"]],
                            "",
                        ],
                        "text-font": [
                            "Open Sans Bold",
                            "Arial Unicode MS Bold",
                        ],
                        "text-offset": [1, 0],
                        "text-anchor": "left",
                        "text-size": 14,
                    },
                    paint: {
                        "icon-color": COLORS.campsite.base,
                        "icon-halo-color": "black",
                        "icon-halo-width": 1,
                        "text-color": "#18181b", // zinc-900
                        "text-halo-color": "white",
                        "text-halo-width": 1.5,
                    },
                    filter: ["==", "$type", "Point"],
                });

                if (portageTooltips) {
                    const tooltip = new maplibregl.Popup({
                        closeButton: false,
                        closeOnClick: false,
                        offset: 12,
                        className: "portage-tooltip",
                    });

                    map.on("mousemove", "canoe", (e) => {
                        if (!e.features || e.features.length === 0) return;
                        const feature = e.features[0];
                        if (feature.properties?.canoe !== "portage") return;

                        const length = feature.properties?.length;
                        if (length == null) return;

                        const meters = Math.round(length);
                        map.getCanvas().style.cursor = "crosshair";
                        tooltip
                            .setLngLat(e.lngLat)
                            .setHTML(`<span>${meters}m portage</span>`)
                            .addTo(map);
                    });

                    map.on("mouseleave", "canoe", () => {
                        map.getCanvas().style.cursor = "";
                        tooltip.remove();
                    });
                }

                if (interactiveProp) {
                    const layers = ["canoe", "campsites"];

                    layers.forEach(layerId => {
                        map.on("mousemove", layerId, (e) => {
                            if (e.features && e.features.length > 0) {
                                const val = e.features[0].properties[interactiveProp];
                                if (val) {
                                    map.getCanvas().style.cursor = "pointer";
                                    map.setPaintProperty("canoe", "line-color", [
                                        "case",
                                        ["==", ["get", interactiveProp], val],
                                        [
                                            "match",
                                            ["get", "canoe"],
                                            "portage",
                                            COLORS.portage.dark,
                                            COLORS.water.dark,
                                        ],
                                        [
                                            "match",
                                            ["get", "canoe"],
                                            "portage",
                                            COLORS.portage.light,
                                            COLORS.water.light,
                                        ],
                                    ]);
                                    map.setPaintProperty("campsites", "icon-color", [
                                        "case",
                                        ["==", ["get", interactiveProp], val],
                                        COLORS.campsite.dark,
                                        COLORS.campsite.light,
                                    ]);
                                }
                            }
                        });

                        map.on("mouseleave", layerId, () => {
                            map.getCanvas().style.cursor = "";
                            map.setPaintProperty("canoe", "line-color", baseLineColor);
                            map.setPaintProperty(
                                "campsites",
                                "icon-color",
                                COLORS.campsite.base,
                            );
                        });

                        map.on("click", layerId, (e) => {
                            if (e.features && e.features.length > 0) {
                                const val = e.features[0].properties[interactiveProp];
                                if (val && interactiveHref) {
                                    navigate(`${interactiveHref}${val}`);
                                }
                            }
                        });
                    });
                }
            } catch (error) {
                console.error("Error loading GeoJSON:", error);
            }
        });
    }
</script>
