---
import { Image } from "astro:assets";

interface Props {
    src: any;
    alt: string;
    width?: number;
    height?: number;
    class?: string;
    imageClass?: string;
}

const {
    src,
    alt,
    width,
    height,
    class: className,
    imageClass,
    ...rest
} = Astro.props;

const isLandscape = src.width >= src.height;
---

<figure
    class:list={[
        "my-8 flex flex-col items-center mx-auto w-full",
        // Apply the specific max-widths based on orientation
        isLandscape ? "max-w-[56rem]" : "max-w-[32rem]",
        className,
    ]}
>
    <Image
        src={src}
        alt={alt}
        width={isLandscape ? 896 : 512}
        class:list={["w-full h-auto rounded-lg shadow-md", imageClass]}
        {...rest}
    />
    <figcaption
        class="mt-2 text-sm text-neutral-600 italic text-center px-4 max-w-2xl"
    >
        <slot />
    </figcaption>
</figure>
