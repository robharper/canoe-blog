---
import BaseLayout from "../layouts/BaseLayout.astro";
import TripCard from "../components/TripCard.astro";
import { getCollection } from "astro:content";

const trips = (await getCollection("trips")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Home">
	<div class="text-center max-w-2xl mx-auto mb-16">
		<h1
			class="text-4xl md:text-5xl font-serif font-bold text-bark-800 mb-4"
		>
			Stories from the Water
		</h1>
		<p class="text-bark-600 text-lg leading-relaxed">
			A collection of canoe trips, map notes, and campfire stories from
			the backcountry.
		</p>
	</div>

	<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
		{trips.map((trip) => <TripCard trip={trip} />)}
	</div>
</BaseLayout>
