---
import BaseLayout from "../layouts/BaseLayout.astro";
import TripCard from "../components/TripCard.astro";
import { getCollection } from "astro:content";
import TripMap from "../components/TripMap.astro";

const trips = (await getCollection("trips")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const geojsonFiles = import.meta.glob('/public/geo/all.geo.json', { eager: true });
const allGeojsonFile = geojsonFiles['/public/geo/all.geo.json'] as any;
const geojson = allGeojsonFile?.default || allGeojsonFile;
---

<BaseLayout title="Home">
	<div class="max-w-4xl mx-auto px-4 md:px-8">
		<div class="text-center max-w-2xl mx-auto mb-16">
			<h1
				class="text-4xl md:text-5xl font-serif font-bold text-zinc-800 mb-4"
			>
				Trip Logs
			</h1>
			<p class="text-zinc-600 text-lg leading-relaxed">
				A collection of canoe trips, map notes, and campfire stories
				from the backcountry.
			</p>
		</div>

		<div class="my-8">
			<TripMap
					geojson={"/geo/all.geo.json"}
					interactive="slug"
			/>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
			{trips.map((trip) => <TripCard trip={trip} />)}
		</div>
	</div>
</BaseLayout>

<script define:vars={{ baseUrl: import.meta.env.BASE_URL }}>
	import { navigate } from "astro:transitions/client";

	const mapElement = document.getElementById("map");
	if (mapElement) {
		mapElement.onMapClick = (slug) => {
			if (slug) {
				navigate(`${baseUrl}trips/${slug}`);
			}
		};
	}
</script>
