---
import { getCollection, render } from "astro:content";
import TripLayout from "../../layouts/TripLayout.astro";
import { computeTripPageStats } from "../../util/tripPageStats.js";

export async function getStaticPaths() {
    const trips = await getCollection("trips");
    return trips.map((trip) => ({
        params: { slug: trip.id },
        props: { trip },
    }));
}

const { trip } = Astro.props;
const { Content } = await render(trip);
const { stats, dailyStats } = computeTripPageStats(trip);
---

<TripLayout trip={trip} stats={stats} dailyStats={dailyStats}>
    <Content dailyStats={dailyStats} />
</TripLayout>
