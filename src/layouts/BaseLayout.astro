---
import "../styles/global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="A canoeing and camping journal" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title} | Canoe Blog</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;0,8..60,700;1,8..60,400&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="min-h-screen flex flex-col font-sans text-zinc-900 bg-zinc-50">
		<header
			class="w-full py-6 px-4 md:px-8 border-b border-gray-100 bg-gray-50/50 backdrop-blur-sm sticky top-0 z-50"
		>
			<div class="max-w-4xl mx-auto flex justify-between items-center">
				<a
					href={import.meta.env.BASE_URL}
					class="text-2xl font-serif font-bold text-sage-800 tracking-tight hover:text-sage-600 transition-colors"
				>
					Adventures in <span class="text-bark-700">Bug Bating</span>
				</a>
				<nav>
					<a
						href={`${import.meta.env.BASE_URL}about`}
						class="text-sm font-medium text-zinc-600 hover:text-river-600 transition-colors"
						>About</a
					>
				</nav>
			</div>
		</header>

		<main class="flex-1 w-full py-8 md:py-12 bg-white">
			<slot />
		</main>

		<footer
			class="w-full py-8 text-center text-zinc-400 text-sm border-t border-zinc-200 mt-auto"
		>
			<p>
				&copy; {new Date().getFullYear()} Canoe Blog. All rights reserved.
			</p>
		</footer>
	</body>
</html>
