---
import BaseLayout from "./BaseLayout.astro";
import TripMap from "../components/TripMap.astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
    trip: CollectionEntry<"trips">;
}

const { trip } = Astro.props;
---

<BaseLayout title={trip.data.title}>
    <article class="max-w-3xl mx-auto">
        <!-- Hero Section -->
        <header class="mb-10 text-center">
            <div class="mb-6 flex flex-col items-center gap-2">
                <span
                    class="inline-block px-3 py-1 rounded-full bg-sage-100 text-sage-800 text-xs font-semibold tracking-wide uppercase"
                >
                    {trip.data.location}
                </span>
                <span class="text-zinc-500 text-sm">
                    {
                        trip.data.date.toLocaleDateString("en-US", {
                            weekday: "long",
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                        })
                    }
                </span>
            </div>
            <h1
                class="text-4xl md:text-5xl font-serif font-bold text-zinc-900 mb-6 leading-tight"
            >
                {trip.data.title}
            </h1>
        </header>

        <!-- Cover Image -->
        <div
            class="mb-12 rounded-xl overflow-hidden shadow-lg border border-zinc-200"
        >
            <Image
                src={trip.data.coverImage}
                alt={trip.data.title}
                class="w-full h-auto"
                width={1200}
                quality="high"
            />
        </div>

        <!-- Map Section (if available) -->
        <!-- Map Section (if available) -->
        {
            (trip.data.geojson || trip.data.mapImage) && (
                <div class="mb-12 bg-white">
                    <h3 class="text-lg font-bold text-zinc-700 mb-4 border-b border-zinc-100 pb-2">
                        Route Map
                    </h3>

                    {trip.data.geojson ? (
                        <TripMap
                            geojson={trip.data.geojson}
                            center={
                                trip.data.mapCenter as
                                    | [number, number]
                                    | undefined
                            }
                        />
                    ) : (
                        <Image
                            src={trip.data.mapImage!}
                            alt={`Map of ${trip.data.title}`}
                            class="w-full h-auto rounded border border-zinc-100 grayscale hover:grayscale-0 transition-all duration-500"
                        />
                    )}
                </div>
            )
        }

        <!-- Content -->
        <div
            class="prose prose-lg prose-zinc max-w-none text-zinc-800 prose-headings:font-serif prose-headings:text-zinc-900 prose-a:text-river-600 hover:prose-a:text-river-800 prose-img:rounded-lg prose-img:shadow-md"
        >
            <slot />
        </div>
    </article>

    <!-- Navigation/Back -->
    <div class="mt-16 pt-8 border-t border-zinc-200 text-center">
        <a
            href="/"
            class="inline-flex items-center gap-2 text-river-700 hover:text-river-900 font-medium transition-colors"
        >
            ← Back to All Trips
        </a>
    </div>
</BaseLayout>
