---
import BaseLayout from "./BaseLayout.astro";
import TripMap from "../components/TripMap.astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
    trip: CollectionEntry<"trips">;
}

const { trip } = Astro.props;
---

<BaseLayout title={trip.data.title}>
    <article class="max-w-3xl mx-auto">
        <!-- Hero Section -->
        <header class="mb-10 text-center">
            <h1
                class="text-4xl md:text-5xl font-bold text-zinc-900 mb-8 leading-tight tracking-tight"
            >
                {trip.data.title}
            </h1>
            <div
                class="flex items-center justify-center gap-3 text-zinc-500 text-sm font-medium uppercase tracking-wider"
            >
                <span class="text-sage-700">{trip.data.location}</span>
                <span class="text-zinc-300">•</span>
                <span>
                    {
                        trip.data.date.toLocaleDateString("en-US", {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                        })
                    }
                </span>
            </div>
        </header>

        <!-- Cover Image -->
        <div
            class="mb-12 rounded-xl overflow-hidden shadow-lg border border-zinc-200"
        >
            <Image
                src={trip.data.coverImage}
                alt={trip.data.title}
                class="w-full h-auto"
                width={1200}
                quality="high"
            />
        </div>

        <!-- Map Section (if available) -->
        <!-- Map Section (if available) -->
        {
            (trip.data.geojson || trip.data.mapImage) && (
                <div class="prose mx-auto">
                    <h2>Route Map</h2>

                    {trip.data.geojson ? (
                        <TripMap
                            geojson={trip.data.geojson}
                            center={
                                trip.data.mapCenter as
                                    | [number, number]
                                    | undefined
                            }
                        />
                    ) : (
                        <Image
                            src={trip.data.mapImage!}
                            alt={`Map of ${trip.data.title}`}
                            class="w-full h-auto rounded border border-zinc-100 grayscale hover:grayscale-0 transition-all duration-500"
                        />
                    )}
                </div>
            )
        }

        <!-- Content -->
        <div class="prose prose-zinc mx-auto my-16 text-zinc-900">
            <slot />
        </div>
    </article>

    <!-- Navigation/Back -->
    <div class="mt-16 pt-8 border-t border-zinc-200 text-center">
        <a
            href="/"
            class="inline-flex items-center gap-2 text-river-700 hover:text-river-900 font-medium transition-colors"
        >
            ← Back to All Trips
        </a>
    </div>
</BaseLayout>
